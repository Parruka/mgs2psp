 		CONDITIONAL_DISABLE(VFPU_VEC);
+		{	// local change (MGS2 port): PPSSPP_VFPU_RN=1 sends vadd / vsub / vdiv / vmul to Int_VecDo3, which rounds as the PSP-3000 does
+			static const bool rn = [] { const char *e = getenv("PPSSPP_VFPU_RN"); return e && *e == '1'; }();
+			const u32 top = op >> 26, sub = (op >> 23) & 7;
