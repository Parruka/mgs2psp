+// local change (MGS2 port, PPSSPP_FPU_FS=1, as the port's patched 1.20.4): the PSP-3000's FPU under FCR31 FS flushes denormal
+// results only and uses denormal inputs exactly in add / sub / mul / div / sqrt / compares, and gives x itself for x +- 0 even
+// when x is a denormal, -x for 0 - x (probe 11 on the PSP); master runs FS as FTZ + DAZ. IRCompFPU.cpp sends those ops here then.
+static bool Mgs2FpuFs() { static const bool on = [] { const char *e = getenv("PPSSPP_FPU_FS"); return e && *e == '1'; }(); return on; }
+struct Mgs2FpuMode {
+	u32 csr = 0;
+	bool on;
+	explicit Mgs2FpuMode(const MIPSState *mips) : on(Mgs2FpuFs()) {
+		if (!on) return;
+		static const u32 rc[4] = { 0, 3, 2, 1 };   // MIPS RN RZ RP RM -> x86 RC
+		csr = _mm_getcsr();
+		_mm_setcsr((csr & ~0xE040u) | (rc[mips->fcr31 & 3] << 13) | ((mips->fcr31 & 0x01000000) ? 0x8000u : 0u));
+		asm volatile("" ::: "memory");
+	}
+	~Mgs2FpuMode() { if (on) { asm volatile("" ::: "memory"); _mm_setcsr(csr); } }
+};
+#define MGS2_FPU_MODE Mgs2FpuMode mgs2FpuMode(mips)
+#else
+#define MGS2_FPU_MODE do {} while (0)
+#endif
