+    if (p23) {
+      const uint32_t V0 = (uint32_t)(int32_t)D[4 * i], V1 = (uint32_t)(int32_t)D[4 * i + 1];
+      var |= ((V0 - U0) ^ du0) | ((V1 - U1) ^ dv0); z2 |= (uint32_t)(uint16_t)D[4 * i + 2] ^ 0x1000u; u2 |= V0 | V1;
+    }
+  }
+  if (bad || (uv >> 15) || z || !used) return -8;
+  L->uv2 = !p23 ? 0 : z2 ? -1 : var ? 2 : 1;
+  L->du = L->uv2 == 1 ? (int)du0 : 0; L->dv = L->uv2 == 1 ? (int)dv0 : 0;
+  if (L->uv2 == 2 && (u2 >> 15)) return -8;   /* pass 2's own UV2 above 32767 */
+  int nw = 0;
+  for (int s = 0; s < 8; s++) if (used >> s & 1) { k->idx[s] = (uint8_t)nw; k->slot[nw++] = (uint8_t)s; } else k->idx[s] = 0;
+  const int st = ((nw + 1) & ~1) + 16;
+  const uint32_t a1 = ((uint32_t)(n * st) + 15u) & ~15u;
+  k->nw = nw; k->stride = st; k->v2 = L->uv2 == 2 ? a1 : 0;
+  k->blo[0] = (int16_t)x0; k->blo[1] = (int16_t)y0; k->blo[2] = (int16_t)z0; k->bhi[0] = (int16_t)x1; k->bhi[1] = (int16_t)y1; k->bhi[2] = (int16_t)z1;
+  k->smin = (uint16_t)s0; k->smax = (uint16_t)s1;
+  return n;
+}
+/* (vu1conv.h) the vertices; with zf each one's w as xconv.c's depth range takes it */
+int vc_p07_c1b(const void *const *p, const VcLit *L, const VcP7C1 *k, uint8_t *v, uint16_t *flags, const float (*zf)[4], float zt, float *zw,
+               long *zn)
+{
+  const int n = L->n, nb = k->nb, w2h = (k->nw + 1) >> 1, st = k->stride, own2 = L->uv2 == 2;
+  const p6h16 *A = (const p6h16 *)p[0], *B = (const p6h16 *)p[1], *C = (const p6h16 *)p[2], *D = (const p6h16 *)p[3];
+  const p6u32 *F = (const p6u32 *)p[5];
+  const uint32_t a1 = ((uint32_t)(n * st) + 15u) & ~15u;
+  float lo = 3.0e38f, hi = 0; long cnt = 0;
+  for (int i = 0; i < n; i++) {
+    union { uint32_t w[2]; uint8_t b[8]; } wb; uint32_t m = 0;
+    wb.w[0] = wb.w[1] = 0;
+    const uint32_t fw = F[2 * i], fb = F[2 * i + 1];
+    if (nb == 1) { const uint32_t j = k->idx[fb >> 2 & 7]; wb.b[j] = 128; m = 1u << j; }
+    else for (int b = 0; b < nb; b++) {
+      const uint32_t w = fw >> (8 * b) & 0xffu, j = k->idx[fb >> (8 * b + 2) & 7], t = wb.b[j] + w;
+      if (t > 255u) return -8;
+      wb.b[j] = (uint8_t)t; m |= (uint32_t)(w != 0) << j;
+    }
+    c1u16 *h = (c1u16 *)(v + st * i);   /* the weights' halfwords, then UV1, the normal, the position */
+    h[0] = (uint16_t)wb.w[0];
+    if (w2h > 1) { h[1] = (uint16_t)(wb.w[0] >> 16); if (w2h > 2) { h[2] = (uint16_t)wb.w[1]; if (w2h > 3) h[3] = (uint16_t)(wb.w[1] >> 16); } }
+    c1u16 *e = h + w2h;
+    e[0] = (uint16_t)C[4 * i]; e[1] = (uint16_t)C[4 * i + 1]; e[2] = (uint16_t)B[4 * i]; e[3] = (uint16_t)B[4 * i + 1]; e[4] = (uint16_t)B[4 * i + 2];
+    e[5] = (uint16_t)A[4 * i]; e[6] = (uint16_t)A[4 * i + 1]; e[7] = (uint16_t)A[4 * i + 2];
+    flags[i] = (uint16_t)A[4 * i + 3];
+    if (own2) {   /* pass 2's copy: UV2 */
+      c1u16 *h2 = (c1u16 *)(v + a1 + st * i), *e2 = h2 + w2h;
+      for (int q = 0; q < w2h; q++) h2[q] = h[q];
+      e2[0] = (uint16_t)D[4 * i]; e2[1] = (uint16_t)D[4 * i + 1];
+      for (int q = 2; q < 8; q++) e2[q] = e[q];
+    }
+    if (zf) {   /* w = t + the weights' sum of each slot's bone w row . (p, 1), the slots in ascending order (xconv.c xc_zr_c1's first form) */
+      const float p0 = A[4 * i], p1 = A[4 * i + 1], p2 = A[4 * i + 2];
+      float w = zt;
+      for (uint32_t mm = m; mm; mm &= mm - 1) {
+        const int j = __builtin_ctz(mm);
+        w += (float)wb.b[j] * (zf[j][0] * p0 + zf[j][1] * p1 + zf[j][2] * p2 + zf[j][3]);
+      }
+      if (w > 0) { if (w < lo) lo = w; if (w > hi) hi = w; cnt++; }
+    }
+  }
+  for (uint32_t o = (uint32_t)(n * st); o < a1; o++) { v[o] = 0; if (own2) v[a1 + o] = 0; }
+  if (zf) { zw[0] = lo; zw[1] = hi; *zn = cnt; }
+  return n;
+}
diff -ruN ge.orig/vu1conv.h ge/vu1conv.h
--- ge.orig/vu1conv.h	2026-10-31 21:34:21.920609868 +0000
+++ ge/vu1conv.h	2026-11-02 05:02:13.789059573 +0000
@@ -158,4 +158,37 @@
 int vc_p07_rec(const uint8_t *vm, uint32_t top, const void *const *p, const uint8_t *kind, const uint16_t *num, VcLit *L, void *v1, void *v3,
                uint16_t *flags, uint32_t *rgba, int max);
 int vc_p07_uv2_rec(const void *d, const VcLit *L, const void *v1, void *v2);
+/* sb11 C1 (stagec_notes.md 1.7-1.9; ge/xconv.c xc_lit_c1): a lane 4 P07 call drawn by the GE's own skinning, lighting and texture
+   matrix.  vc_p07_c1: the call's header and constants as p07_main reads them, without its vertex loop.  -8: p07_main's fast form would
+   not take the call (or a stream it reads is missing: vc_p07_rec's -8); -9: it would, but the GE cannot draw it (the clamp abs 3 x not
+   255, a light colour times its direction's length or the ambient outside 0..255); else n, with L as vc_p07_rec gives it but for uv2,
+   du, dv (vc_p07_c1v's) and k the GE's constants: the bones a vertex (nb), each light's direction (column j of abs 24..26, normalised)
+   and colour (row j of abs 28..30 times that column's length, rounded; 0: off), the ambient (abs 31, rounded; the GE's alpha, the PS2's
+   doubled, in bits 24-31), pass 3's matrix (TGEN rows: s R[.][j], translation o, q 1) */
+typedef struct {
+  const float (*ldir)[3]; const uint32_t *lcol; uint32_t amb; const float *tgen; int nb;   /* vc_p07_c1 (c1opt2: ldir, lcol and tgen
+                                                     point at its constants, which the next call may change) */
+  int nw, stride; uint32_t v2; uint8_t slot[8], idx[8];              /* vc_p07_c1s (idx: each slot's place among slot[]) */
+  int16_t blo[3], bhi[3]; uint16_t smin, smax;                        /* vc_p07_c1s (c1opt2): the box of the positions, the least and
+                                                     largest sum of a vertex's weights (a 1-bone call's 128) */
+} VcP7C1;
+int vc_p07_c1(const uint8_t *vm, uint32_t top, const void *const *p, const uint8_t *kind, const uint16_t *num, VcLit *L, VcP7C1 *k);
+/* vc_p07_c1s and vc_p07_c1b: the call's GE vertices from its streams (p as vc_p07_rec's, after vc_p07_c1 took the call: L->n, L->p3 and
+   k->nb set), in two steps so the bones can be read between them (c1opt, 2026-11-02; the first form, vc_p07_c1v, did both in one).
+   vc_p07_c1s reads the slots and the checks: k->slot[0 .. k->nw - 1] the slots the call names in ascending order (offset / 4, with a
+   weight above 0 or the one bone), k->idx each slot's place among them, k->stride = align2(nw) + 16 bytes, k->v2 the offset of pass 2's
+   own copy (uv2 2; else 0); L->uv2, du, dv as p07_main gives them.  Returns n, or -8 where p07_main would not take the call (a UV1 above
+   32767 or its z other than 1.0) or the GE cannot (a bone offset not a multiple of 4 or above 28, a UV2 above 32767 for uv2 2).
+   vc_p07_c1b writes the vertices: its weights by slot place (a 1-bone call's 128, the others' bytes summed by slot), UV1 (16-bit), the
+   normal and the position (16-bit, as the streams hold them: the GE reads s / 32768, the bones carry the rest), at v, and with uv2 2
+   pass 2's own copy with UV2 at v + k->v2 (n x stride rounded up to 16; the pads zeroed); flags[i]: stream A's w (the strip flags).
+   With zf (each slot place's bone w row, 4 floats, and the translation zt), each vertex's w = zt + sum over its slots in ascending
+   order of weight x (zf[j] . (p, 1)), and of those above 0 the least and largest in zw[0], zw[1] and their count in *zn (xconv.c's
+   depth range).  Returns n, or -8 (a slot's weights above 255 in a vertex) */
+int vc_p07_c1s(const void *const *p, VcLit *L, VcP7C1 *k);
+int vc_p07_c1b(const void *const *p, const VcLit *L, const VcP7C1 *k, uint8_t *v, uint16_t *flags, const float (*zf)[4], float zt, float *zw,
+               long *zn);
+/* the bone matrix at abs m (32 + 4 s) as the GE takes it: GE rows (the images of x, y, z, then the translation), x 2048 in the 3 x 3 (the
+   GE reads 16-bit positions as s / 32768, the PS2 12.4); 0 where p7_loop would not take it (m above 60, or p7_mok) */
+int vc_p07_bone(const uint8_t *vm, uint32_t m, float *b12);
 #endif
diff -ruN ge.orig/xconv.c ge/xconv.c
--- ge.orig/xconv.c	2026-11-02 02:21:07.019764284 +0000
+++ ge/xconv.c	2026-11-02 05:39:21.152792692 +0000
@@ -2,8 +2,12 @@
    pictures and the MGS2GE replays were checked with; gsref GSREF_XLCONV=1 compares the two batch by batch. */
 #include "xconv.h"
 #include "vu1conv.h"
+#ifndef __psp__
+#include "c1model.h"   /* sb11 C1 census and GE model (x86 only) */
+#endif
 #include <stddef.h>
 #include <string.h>
+#include <math.h>   /* c1opt2: fabsf (xc_c1_zin) */
 
 static XcStats St;
 const XcStats *xc_stats(void) { return &St; }
@@ -398,6 +402,139 @@
 static uint8_t Sv[16384] __attribute__((aligned(64)));   /* the scratch VU memory: a held call's rebuilt memory, or its image when pass 3 is drawn */
 static void sv_rebuild(const XcHeld *r);
 static void sv7_rebuild(const XcHeld *r);   /* sb10 T2: a held P07 call's vertices in Sv (vc_p07_rec -8) */
+/* ---- sb11 C1 (stagec_notes.md 1.7-1.9; xconv.h XcHost.c1): a lane 4 P07 call drawn by the GE's own skinning, lighting and texture
+   matrix.  Its blob: [GerXform][a GerLit a pass][pass 1's vertices][pass 2's own (uv2 2)][GerC1 with its nw bones][strips], each part
+   from a 16-byte boundary, the pads zeroed; each GerLit's vtx is the GerC1 (ge/replay_fmt.h).  The vertices are built at each call:
+   checking a kept copy against the streams would read the same bytes as building it ---- */
+#define C1_GXL(np) ((uint32_t)(sizeof(GerXform) + (uint32_t)(np) * sizeof(GerLit)))
+#define VT_C1(nw) (0x342u | ((uint32_t)(nw) - 1u) << 14)   /* GU_WEIGHTS(nw) | GU_WEIGHT_8BIT | GU_VERTEX_16BIT | GU_NORMAL_16BIT | GU_TEXTURE_16BIT */
+static uint32_t xc_c1_bound(uint32_t n, uint32_t hy)   /* (a vertex at most 8 weights + 16 bytes; passes 1 and 2's; the strips at most n) */
+{
+  const uint32_t np = 1 + ((hy & 0x10) != 0) + ((hy & 0x700) != 0);
+  return ((C1_GXL(np) + 15u) & ~15u) + 2 * ((n * 24u + 15u) & ~15u) + ((GERC1_SIZE(8) + 15u) & ~15u) + n * 4u;
+}
+uint32_t xc_c1_hold_bound(const XlCall *c, uint32_t bound)
+{
+  const uint32_t *hd = vq(c->vm, c->top), b1 = xc_c1_bound(hd[0] & 0xffff, hd[3] & 0xffff);
+  return b1 > bound ? b1 : bound;
+}
+/* the depth range (XcZr) of a C1 call: w, the GE's view z, of each vertex skinned as the GE does it, sum_k a_k (row . bone_k (p / 32768))
+   + t over its slots k (a_k its weight / 128, row and t the view matrix's w row), in float as xc_zr_lit's (it differs from the exact
+   form's w by rounding only, far less than the depth map's margin, gelist.h gx_depth_map).  vc_p07_c1b computes it as it writes the
+   vertices (c1opt; xc_lit_c1 gives it each bone's w row, xc_c1_zf), this merges the call's range [lo, hi] of its cnt vertices in front.
+   (A bound by each bone over the box of the call's positions was 18% of the map's width too wide in most face frames on x86: the
+   faces' depth precision, so it is not used) */
+static void xc_c1_zf(const VcXform *x, const GerC1 *g, float zf[8][4])
+{
+  const float a = x->world[2], b = x->world[5], c = x->world[8];
+  for (int k = 0; k < (int)g->nw; k++) {   /* bone k's w row, for p as the stream holds it and a weight as a whole number */
+    const float *m = g->bone[k];
+    for (int col = 0; col < 3; col++) zf[k][col] = (m[3 * col] * a + m[3 * col + 1] * b + m[3 * col + 2] * c) * (1.0f / (32768.0f * 128.0f));
+    zf[k][3] = (m[9] * a + m[10] * b + m[11] * c) * (1.0f / 128.0f);
+  }
+}
+/* c1opt2: 1 when every w of the call lies inside the range the depth range keeps so far for its projection, by a bound over the box of
+   its positions and the least and largest sum of a vertex's weights (vc_p07_c1s): w - t = sum_k a_k (zf_k . (p, 1)) with a_k >= 0 summing
+   to the vertex's S, each zf_k . (p, 1) inside [the least, the largest of that affine function over the box], so w - t inside S times
+   [the least of those over the slots, the largest]; widened by 1e-5 of the magnitudes (float rounding of w and of this bound is below
+   2e-6 of them).  Its exact w then cannot move the range and all lie in front (cnt n), so vc_p07_c1b need not compute them: the result
+   is the same.  x86 codec route: 77% of the C1 calls (70% of their vertices) were inside by this bound, 93% by their exact w; the bound
+   never missed an exact w.  c1opt3: the box as its centre q and half extents e (exact: halved sums of int16), so a slot's least and
+   largest over it are d - r and d + r with d = zf . (q, 1) and r = |zf| . e (the same bound as c1opt2's min and max of the corners'
+   products, without a branch per axis: 570 instructions a call on the PSP model before, 188 now, codec window).  A NaN or an infinity in any slot's
+   terms makes chk not finite: no (and a NaN zt fails the tests) */
+static int xc_c1_zin(const XcZr *z, const VcXform *x, const VcP7C1 *k, const float zf[8][4], float zt)
+{
+  if (!z->on || x->pa != z->pa || x->pb != z->pb || x->vs[2] != z->vs2 || x->vo[2] != z->vo2) return 0;
+  const float q0 = 0.5f * (float)((int)k->blo[0] + k->bhi[0]), q1 = 0.5f * (float)((int)k->blo[1] + k->bhi[1]),
+              q2 = 0.5f * (float)((int)k->blo[2] + k->bhi[2]);
+  const float e0 = 0.5f * (float)((int)k->bhi[0] - k->blo[0]), e1 = 0.5f * (float)((int)k->bhi[1] - k->blo[1]),
+              e2 = 0.5f * (float)((int)k->bhi[2] - k->blo[2]);
+  const float m0 = fabsf(q0) + e0, m1 = fabsf(q1) + e1, m2 = fabsf(q2) + e2;   /* the largest |p| on each axis */
+  float mn = 3.0e38f, mx = -3.0e38f, big = 0, chk = 0;
+  for (int j = 0; j < k->nw; j++) {
+    const float *f = zf[j], a0 = fabsf(f[0]), a1 = fabsf(f[1]), a2 = fabsf(f[2]);
+    const float d = f[3] + f[0] * q0 + f[1] * q1 + f[2] * q2, r = a0 * e0 + a1 * e1 + a2 * e2;
+    const float a = fabsf(f[3]) + a0 * m0 + a1 * m1 + a2 * m2, dl = d - r, dh = d + r;
+    mn = dl < mn ? dl : mn; mx = dh > mx ? dh : mx; big = a > big ? a : big; chk += (dh - dl) + a;
+  }
+  if (!(chk - chk == 0)) return 0;
+  const float s0 = (float)k->smin, s1 = (float)k->smax, E = 1e-5f * (fabsf(zt) + s1 * big) + 1e-30f;
+  const float blo = zt + (mn >= 0 ? s0 * mn : s1 * mn) - E, bhi = zt + (mx >= 0 ? s1 * mx : s0 * mx) + E;
+  return blo > 0 && blo >= z->wmin && bhi <= z->wmax;
