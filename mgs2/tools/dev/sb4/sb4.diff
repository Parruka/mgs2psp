+#define MGS2_FXTHIN_H
+#include <stdint.h>
+#include "xconv.h"
+
+#define FX_KINDS 2      /* 0: the sheets of drops close to the camera (d_splash_camera.c), 1: the splash at the feet (ft_splsh.c) */
+#define FX_RANGES 16    /* blocks a frame (more instances are not thinned: counted in over) */
+#define FX_CACHE 512    /* (act function, name pointer) pairs (a power of two; the deck has about 140) */
+typedef struct FxThin {
+  int keep[FX_KINDS];                 /* 1 strip in keep[k] of kind k's calls drawn (1: all) */
+  XcThin r[FX_RANGES]; int n;         /* this frame's blocks */
+  struct { uint32_t ak, np; } c[FX_CACHE]; int nc;   /* ak: the act function | its kind (0 an empty entry, 1 another actor, 2 + the
