+  uint32_t sig[8];                    /* the stage image's header the cache was filled under */
+  long scans, actors, named, flushes, found[FX_KINDS], bad, over;   /* scans; actors walked; names read; cache emptied; blocks found by
+                                         kind; walks or objects that did not look right (the frame is not thinned past them); blocks over
+                                         FX_RANGES */
+} FxThin;
+void fx_thin_init(FxThin *t, int keep_sheets, int keep_splash);   /* shares 1..8 */
+int fx_thin_on(const FxThin *t);                                  /* 1: a share above 1 */
+int fx_thin_scan(FxThin *t, const uint8_t *ram);                  /* ram: the guest's 32 MB; this frame's blocks into t->r, their number */
+#endif
