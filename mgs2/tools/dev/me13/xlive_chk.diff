+static void dl_report(void)
+{
+  dl_line("totals", &dl_all);
+  for (int i = 0; i < dl_ng0; i++) fprintf(stderr, "me13 g0: %s (%x-%x): stores %ld, with a frame in flight %ld\n", dl_g0[i].name, dl_g0[i].a, dl_g0[i].e,
+                                           dl_g0[i].st, dl_g0[i].fl);
