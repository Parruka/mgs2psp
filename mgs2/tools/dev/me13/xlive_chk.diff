+                               "the design's copy: all kinds but the upload sources outside the packets" };
+  for (int w = 0; w < 4; w++) { long n = 0, c = 0; int pct[5] = { 50, 90, 99, 999, 1000 }; for (int i = 0; i <= 512; i++) n += cs_hist[w][i];
+    fprintf(stderr, "me12 copy sizes (%s): %ld steps;", wn[w], n);
+    for (int j = 0, i = 0; j < 5 && n; j++) { long need = pct[j] == 1000 ? n : pct[j] == 999 ? (n * 999 + 999) / 1000 : (n * pct[j] + 99) / 100;
+      while (i <= 512 && c + cs_hist[w][i] < need) c += cs_hist[w][i++];
