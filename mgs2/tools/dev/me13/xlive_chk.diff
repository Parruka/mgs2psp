+void rt_dgt_copy(uint32_t dst, uint32_t src, uint32_t n) { (void)src; if (wt_on && (dst & (GSZ - 1)) >= 0x4000) wt_note(dst, n, 0x208); }
+void rt_dgt_vu(uint32_t h, int pc) { (void)h; (void)pc; }
+void rt_dgt_mpg(void) {}
+void host_enter(int k) { if (k == HOST_DG) wt_dg++; }
+void host_leave(int k) { if (k == HOST_DG) wt_dg--; }
+static void df_apply(DfE *e)   /* the queue runs a transfer: its copy into the shadow; what the game changed since, counted */
+{
+  const uint8_t *o = e->lg, *end = e->lg + e->ln; int any = 0;
+  cs_nr = 0;
+  while (o < end) { uint32_t a, n, k; memcpy(&a, o, 4); memcpy(&n, o + 4, 4); memcpy(&k, o + 8, 4); const uint8_t *d = o + 12;
+    if (memcmp(d, df_live + a, n)) { long c = 0; for (uint32_t i = 0; i < n; i++) c += d[i] != df_live[a + i];
+      ds_w.chg += c; ds_w.chgr++; any = 1; ds_w.pchg[DS_PLACE(a)] += c;
+      if (ds_prn < 80) { ds_prn++; fprintf(stderr, "me9 snap: vb %ld ch %d at %08x bytes %u: %ld changed before the queue ran\n", e->vb, e->ch, a, n, c); } }
+    memcpy(df_sh + a, d, n); o += 12 + n; }
