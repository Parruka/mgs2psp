+int g_dgt_w, g_dgt_o;
+void rt_dgt_rd(uint32_t a) { (void)a; }
+void rt_dgt_wr(uint32_t a, int n) { if (wt_on) wt_note(a, (uint32_t)n, (uintptr_t)__builtin_return_address(0) - (uintptr_t)&__executable_start); }
