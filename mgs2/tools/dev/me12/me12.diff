+static void cs_count(DfE *e)
+{
+  const uint8_t *o = e->lg, *end = e->lg + e->ln;
+  while (o < end) { uint32_t a, n, k; memcpy(&a, o, 4); memcpy(&n, o + 4, 4); memcpy(&k, o + 8, 4); const uint8_t *d = o + 12;
+    long cg[2] = { 0, 0 }, chg[2] = { 0, 0 }; int rng[2] = { 0, 0 }; uint32_t r = a >> 16;
+    for (uint32_t g = 0; g < n; g += 16) { uint32_t m = n - g < 16 ? n - g : 16; int u = CS_UP(a + g); long c = 0;
+      cg[u] += m;
+      if (memcmp(d + g, df_live + a + g, m)) { for (uint32_t i = 0; i < m; i++) c += d[g + i] != df_live[a + g + i]; chg[u] += c; rng[u] = 1;
+        if (wt_on) { uint32_t gg = (a + g) >> 4;   /* me12: a change no reported write explains */
+          if (!((wt_wb[gg >> 3] >> (gg & 7)) & 1)) { wt_untr += c; wt_untr_g++; wt_untr_u += u;
+            if (wt_prn < 80) { wt_prn++; fprintf(stderr, "me12 untracked: vb %ld ch %d kind %u%s at %07x: %ld bytes changed, no reported write\n", e->vb, e->ch, k, u ? " upload" : "", a + g, c); } } } } }
