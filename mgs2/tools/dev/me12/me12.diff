+/* me12 (task #142, the ME hand-off design): who writes the bytes a transfer reads while they are in flight, from the transfer to the end of
+   the step after it (what a second CPU reading them one or two steps late would miss).  MGS2_XLIVE_WT=1 with MGS2_XLIVE_DEFER=2
+   MGS2_XLIVE_SNAP=2, in a build whose game code reports each store (its units built with GEN_DG_TRACE: rt_dgt_wr, rt_dgt_wrh) and whose
+   runtime reports its scratchpad copies (boot.c built with WT_TRACK and me12's runtime/ee_io.h: rt_dgt_copy).  Per 16-byte granule of EE
+   RAM: the step of the last transfer that read it and its kind.  A write into a granule read in this step is class 0 (in its transfer's
+   step: a one-step-late reader misses it too), read in the step before class 1.  Counted by writer (the store's host address as an offset
+   in the executable: tools/wt_names.py names its function with nm; 0x208 the scratchpad DMA to RAM), kind (| 4: an upload source), class
+   and whether the PS2 draw pipeline was running.  The census (cs_count) then counts the changed bytes that no reported write explains. */
+static long cur_vb;
+static int wt_on, wt_dg; static int32_t *wt_ks, wt_step = 1; static uint8_t *wt_kd, *wt_wb;
+typedef struct { uintptr_t w; uint8_t k, c, dg; long n, b, steps, vb0; int32_t last; uint32_t a0; } WtE;
+#define WT_N (1 << 16)
+static WtE *wt_t; static long wt_tn, wt_drop, wt_hits, wt_all, wt_untr, wt_untr_g, wt_untr_u, wt_prn;
+extern char __executable_start;
+/* me12 step 3: every reported store by its store site (the guard cost of a list of sites or functions) */
+typedef struct { uintptr_t w; long n; } WsE;
+#define WS_N (1 << 18)
+static WsE *ws_t; static long ws_tn, ws_drop;
+static void ws_count(uintptr_t w)
+{
+  uint32_t h = (uint32_t)(((uint64_t)w * 0x9E3779B97F4A7C15ull) >> 46) & (WS_N - 1);
+  while (ws_t[h].n && ws_t[h].w != w) h = (h + 1) & (WS_N - 1);
+  if (!ws_t[h].n) { if (ws_tn > WS_N * 3 / 4) { ws_drop++; return; } ws_t[h].w = w; ws_tn++; }
+  ws_t[h].n++;
+}
+static void wt_note(uint32_t a, uint32_t n, uintptr_t w)
+{
+  uint32_t g, e; int hit = -1; uint8_t k = 0, dg;
+  wt_all++; if (ws_t) ws_count(w);
+  a &= GSZ - 1; g = a >> 4; e = (a + (n ? n : 1) - 1) >> 4; if (e >= GSZ / 16) e = GSZ / 16 - 1;
+  for (; g <= e; g++) { int32_t s = wt_ks[g], d; if (!s) continue; d = wt_step - s;
+    if (d < 0 || d > 1) continue;
+    wt_wb[g >> 3] |= (uint8_t)(1u << (g & 7));
+    if (hit < 0 || d < hit) { hit = d; k = (uint8_t)(wt_kd[g] | (CS_UP(g << 4) ? 4 : 0)); } }
+  if (hit < 0) return;
+  wt_hits++; dg = wt_dg > 0;
