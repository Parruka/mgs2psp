+/* me11: the copy laid over the game's RAM for the walk (the live bytes saved), then the RAM put back, last record first */
+static void ov_lay(DfE *e)
+{
+  const uint8_t *o = e->lg, *end = e->lg + e->ln; size_t need = e->ln, sp = 0;
+  if (need > ov_cap) { ov_cap = need * 2; if (!(ov_save = realloc(ov_save, ov_cap))) exit(1); }
