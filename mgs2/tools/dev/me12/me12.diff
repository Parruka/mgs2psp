+static void wt_kick(void)   /* a transfer comes: its granules are in flight from this step */
+{
+  for (long i = 0; i < df_nr; i++) { uint32_t a = df_r[i].a, n = df_r[i].n; uint8_t k = (uint8_t)df_r[i].k;
