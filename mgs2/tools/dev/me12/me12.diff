+  while (o < end) { uint32_t a, n; memcpy(&a, o, 4); memcpy(&n, o + 4, 4); memcpy(ov_save + sp, live + a, n); sp += n; memcpy(live + a, o + 12, n); o += 12 + n; }
+}
+static void ov_back(DfE *e)
+{
+  long nr = 0; const uint8_t *o = e->lg, *end = e->lg + e->ln; size_t sp = 0;
+  static const uint8_t **rp; static long rcap; static size_t *rs;
+  while (o < end) { uint32_t n; memcpy(&n, o + 4, 4);
