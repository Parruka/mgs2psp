+  if (b == 0.0f) { uint32_t ua, ub, u; memcpy(&ua, &a, 4); memcpy(&ub, &b, 4); u = ((ua ^ ub) & 0x80000000u) | 0x7f7fffffu; float r; memcpy(&r, &u, 4); return r; }
+  return vc_vu(a / b);
+}
