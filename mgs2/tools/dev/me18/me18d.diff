diff -ruN me18c/ge/xme.c me18d/ge/xme.c
--- me18c/ge/xme.c	1970-01-01 00:00:00.000000000 +0000
+++ me18d/ge/xme.c	2026-11-08 12:33:19.478890573 +0000
@@ -0,0 +1,94 @@
+/* xme.c: the ME's loop (task #180 step 4c; xme.h).  The records' copies and walks are psp/xl_psp.c's 4b-2 (mp_fill_all, mp_late), the
+   frame's end, list and start its xl_psp_frame and gl_list without the GE and the display, moved here so that one loop serves the ME
+   (4d), its thread on the emulator (4c) and the main CPU's own turns. */
+#include <string.h>
+#include "xme.h"
+#include "me_rt.h"                      /* -DMGS2_ME_SAFE: ME_CALLP */
+
+static void xme_sum(XmeCtx *x)          /* psp/xl_psp.c sum(): the translator's 32-bit counters summed a walk at a time */
+{
+  const XlStats *S = xl_stats(); uint32_t q = (uint32_t)x->m->qw, w = (uint32_t)S->words, c = (uint32_t)S->calls, a = (uint32_t)S->ad_kicks;
+  x->t_qw += q - x->l_qw; x->l_qw = q; x->t_words += w - x->l_words; x->l_words = w;
+  x->t_calls += c - x->l_calls; x->l_calls = c; x->t_ad += a - x->l_ad; x->l_ad = a;
+}
+static void xme_rec(XmeCtx *x, const XmeRec *e)
+{
+  XmeRec *r;
+  x->n_rec++;
+  if (x->nrec == XME_NREC) { x->n_over++; return; }   /* (the main CPU walks at 64: not expected) */
+  r = &x->rec[x->nrec++]; *r = *e;
+  if (r->nx < 0) { x->n_ram++; return; }               /* walked from RAM */
+  xm_fill(&x->fc, r->x0, r->nx, 0, 0, 0);              /* the copy from RAM as it is now (the log comes at the FILL) */
+  if (r->now) x->n_now++; else x->n_early++;
+}
+static void xme_fill(XmeCtx *x, int nlog)              /* the log over the early copies since the last FILL: they hold the bytes as their
+                                                          transfers started */
+{
+  for (int i = 0; i < x->nrec; i++) {
+    XmeRec *r = &x->rec[i];
+    if (r->nx < 0 || r->now) continue;
+    x->at = XME_AT_LAY + (uint32_t)i; xm_lay(&x->fc, r->x0, r->nx, r->t, x->log, nlog); r->now = 1; x->n_lay++;
+  }
+  x->n_fill++;
+}
+static void xme_walk(XmeCtx *x)                        /* psp/xl_psp.c 4b-2 mp_late's walks */
+{
+  XmPic *p = x->p; XlvMem *m = x->m; XmView *v = x->v;
+  for (int i = 0; i < x->nrec; i++) {
+    const XmeRec *r = &x->rec[i];
+    x->at = XME_AT_WALK + (uint32_t)i;
+    if (r->restart) { xme_sum(x); gu_zero_empty(p->map, 0); xl_reset(); x->l_words = x->l_calls = x->l_ad = 0; x->n_restart++; }
+    xm_switch(p, r->opt, r->opt2);
+    if (r->nx >= 0) { v->x = x->fc.ext + r->x0; v->n = r->nx; v->last = 0; m->view = v; }
+    xm_walk(p, r->ch, r->chcr, r->madr, r->qwc, r->tadr, r->lanes, r->opt);
+    m->view = 0; xme_sum(x); x->heart++; x->n_walked++;
+  }
+  x->nrec = 0; x->n_walk++;
+}
+static uint32_t xme_released(const XmeCtx *x) { return x->ge_done; }
+static void xme_hook(XmeCtx *x, const XmeHook *h, XmeWait w)
+{
+  XmPic *p = x->p;
+  x->n_hook++;
+  if (h->stop) { p->now = 0; return; }                 /* the GE stopped: no more frames */
+  if (h->end) {
+    XmeRes *s; int r;
+    while ((int32_t)(x->listed - xme_released(x)) >= (int32_t)XME_NRES) { x->n_resfull++; x->heart++; x->at = XME_AT_RESFULL; ME_CALLP(w)(x, 1); }
+    x->at = XME_AT_END; xm_end(p); x->at = XME_AT_LIST; r = xm_list(p, h->d, h->dig);
+    s = &x->res[x->listed % XME_NRES];
+    s->fvb = h->vb - 1; s->d = h->d; s->r = r; s->nt = (int)p->glf->o.nt; s->dig = h->dig; s->list = p->gxl->w;
+    s->dig_list = p->gxl->dig; s->dig_frame = h->dig ? p->dig_frame : 0; s->c = p->gxl->c;
+    XME_BARRIER(); x->listed++; x->n_list++;
+  }
+  if (h->begin) {   /* the GE must have finished every list before: the frame's arena, the list buffer, the cache's last textures */
+    while ((int32_t)(x->listed - xme_released(x)) > 0) { x->n_gewait++; x->heart++; x->at = XME_AT_GEWAIT; ME_CALLP(w)(x, 1); }
+    x->at = XME_AT_BEGIN; xm_begin(p, h->opt, h->opt2); x->n_begin++;
+  }
+  x->at = XME_AT_TKFRAME; tk_frame(p->tk);
+}
+int xme_entry(XmeCtx *x, const XmeE *e, XmeWait w)
+{
+  int k = e->kind, ret = 0;   /* (no switch: -fno-jump-tables keeps it a chain anyway) */
+  x->at = (uint32_t)k;
+  if (k == XE_REC) xme_rec(x, &e->r);
+  else if (k == XE_FILL) xme_fill(x, e->nlog);
+  else if (k == XE_WALK) xme_walk(x);
+  else if (k == XE_HOOK) xme_hook(x, &e->h, w);
+  else if (k == XE_THIN) { gl_thin(x->p->glf, x->thin_r, x->thin_n, x->thin_keep3, x->thin_d, x->thin_nd); x->n_thin++; }
+  else if (k == XE_STOP) ret = 1;
+  return ret;   /* (the place word goes back to 0 in xme_run, after the tail: a take-back that sees 0 sees every entry before whole) */
+}
+void xme_run(XmeCtx *x, XmeWait w)
+{
+  for (;;) {
+    uint32_t t = x->tail; const XmeE *e;
+    if (t == x->head) {   /* empty: idle until the main CPU posts (it signals when it sees idle; the wait has a time limit too) */
+      x->heart++; x->idle = 1; x->at = XME_AT_IDLE;
+      if (x->tail == x->head) ME_CALLP(w)(x, 0);
+      x->at = 0; x->idle = 0; continue; }
+    XME_BARRIER(); e = &x->e[t & (XME_N - 1)];
+    if (e->kind == XE_HOOK && x->hang_vb >= 0 && e->h.vb >= x->hang_vb) { x->hung = 1; x->at = XME_AT_HANG; for (;;) ME_CALLP(w)(x, 2); }   /* the hang test */
+    if (xme_entry(x, e, w)) { XME_BARRIER(); x->tail = t + 1; XME_BARRIER(); x->at = 0; x->stopped = 1; return; }
+    XME_BARRIER(); x->tail = t + 1; XME_BARRIER(); x->at = 0; x->heart++;
+  }
+}
diff -ruN me18c/ge/xme.h me18d/ge/xme.h
--- me18c/ge/xme.h	1970-01-01 00:00:00.000000000 +0000
+++ me18d/ge/xme.h	2026-11-08 12:33:30.454778193 +0000
@@ -0,0 +1,76 @@
+/* xme.h: the ME's loop and the queue the main CPU feeds it (task #180, the ME picture's build order step 4c: me_step4_notes.md 4c;
+   me_handoff_design.md 4.6).  Built with the rest of the picture code into the ME's unit (-DMGS2_ME_SAFE): no printing, no system
+   call; the host's waits are calls through pointers (ME_CALLP).  In 4c the loop runs as a thread on the main CPU in the emulator
+   (PPSSPP has no ME), or the main CPU runs its entries itself (a turn of today's path, or after a take-back).
+
+   The main CPU (psp/xl_psp.c MGS2_ME_PIC=3) keeps the runtime's walk, each transfer's record and its copy's plan (ge/xlme.c xm_plan),
+   the filter and the guards' log, the thinning's scan (it reads the game's RAM), the GE and the display.  It posts, in order:
+   - XE_REC: a record as its transfer ends, with its copy's extents.  The ME copies them at once from RAM (xm_fill without the log):
+     now 1, a copy that must hold the bytes as the transfer ended (before vb 60, or with scratchpad bytes: the main CPU waits for it);
+     now 0, an early copy, whose bytes the guards' log makes right at the FILL; nx -1: no copy, the record walked from RAM (the main
+     CPU waits for that walk).
+   - XE_THIN: the thinning's ranges for the frame begun last, from the slot below (gl_thin).
+   - XE_FILL: the deadline (the hook that ends the step), or the log or the queue full or no room in the arena early: the log's first
+     nlog entries laid over every early copy since the last FILL (xm_lay); the main CPU waits for it, then empties the log and the filter.
+   - XE_WALK: the records since the last WALK walked in order through their copies (the restart, the switches, the late walk, the sums);
+     the main CPU plans no new copy (and from the next hook on waits) until it is done: the arena is in use, and the picture must be
+     made by the end of the step after its transfers' (the x86 check's latest).
+   - XE_HOOK: a vblank hook while the picture is on: the frame's end and its GE list (into a result slot), a frame's start (only once
+     the GE has finished every list before: the frame's arena, the one list buffer and the texture cache's last textures are the GE's
+     until then), the texture cache's frame (tk_frame); stop 1: the GE stopped, the frame dropped.
+   - XE_STOP: the run's end.
+   Shared words (head, tail, heart, listed, ge_done) are the host's and the ME's; on the real ME (4d) they go through the uncached
+   alias, and the main CPU writes back its cache before raising head. */
+#ifndef MGS2_XME_H
+#define MGS2_XME_H
+#include <stdint.h>
+#include "xlme.h"
+#include "xconv.h"   /* XcThin */
+
+#define XME_N 256u          /* the queue's entries (a power of two): a step posts at most 64 records and 4 others, and the main CPU waits
+                               at each hook for the walk of two steps before */
+#define XME_NREC 64         /* records between two walks (psp/xl_psp.c MP_NREC) */
+#define XME_NRES 4          /* lists made and not yet taken by the main CPU (one at a time: a frame starts only once the GE has
+                               finished every list before) */
+#define XME_BARRIER() __asm__ __volatile__("" ::: "memory")   /* the compiler keeps the entry's or result's stores before the shared word's
+                                                                (4d adds the caches: the main CPU's writeback, the uncached alias) */
+enum { XE_REC = 1, XE_THIN = 2, XE_FILL = 3, XE_WALK = 4, XE_HOOK = 5, XE_STOP = 6 };
+enum { XME_AT_WALK = 0x100, XME_AT_LAY = 0x200, XME_AT_RESFULL = 0x300, XME_AT_GEWAIT = 0x301, XME_AT_END = 0x310, XME_AT_LIST = 0x311,
+       XME_AT_BEGIN = 0x312, XME_AT_TKFRAME = 0x313, XME_AT_IDLE = 0x500, XME_AT_HANG = 0x600 };
+typedef struct { int ch, lanes, restart, x0, nx, t, now; uint32_t chcr, madr, qwc, tadr, opt, opt2; } XmeRec;
+typedef struct { int32_t vb; int end, d, dig, begin, stop; uint32_t opt, opt2; } XmeHook;
+typedef struct { int kind, why, nlog; XmeRec r; XmeHook h; } XmeE;
+typedef struct { int32_t fvb; int d, r, nt, dig; uint32_t *list; uint64_t dig_list, dig_frame; GxCount c; } XmeRes;
+struct XmeCtx;
+typedef void (*XmeWait)(struct XmeCtx *x, int why);   /* the host's wait: why 0 the queue empty (the loop's idle), 1 the GE (a frame's
+                                                          start), 2 the hang test (never returns) */
+typedef struct XmeCtx {
+  /* the host's, before the loop starts */
+  XmPic *p; XlvMem *m; XmView *v;
+  XmCopy fc;                  /* the copies as the ME fills them: mem, spr, mem_size, arena, arena_n and ext (the main CPU's plans write
+                                 ext before they are posted); fills, laid, laid_lines, laid_b: the ME's counts */
+  const XmLogE *log;          /* the main CPU's log: a FILL lays its first nlog entries */
+  int32_t hang_vb;            /* the hang test (MGS2_ME_PIC_HANG; the thread's loop only): at the first HOOK with vb >= hang_vb the loop
+                                 stops with its heartbeat stopped; -1: none */
+  /* shared words */
+  volatile uint32_t head, tail; /* entries posted by the main CPU, done by the ME */
+  volatile uint32_t heart;      /* the ME's heartbeat */
+  volatile uint32_t listed;     /* lists the ME made (results posted) */
+  volatile uint32_t ge_done;    /* lists the GE has finished or the main CPU let go (the main CPU's) */
+  volatile uint32_t idle, stopped, hung;
