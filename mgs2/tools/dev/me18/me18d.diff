+  if (mq_tbk_cold != tb || !mp_nrec) return;   /* (a take-back: the record dropped) */
+  e = &mp_rec[mp_nrec - 1];
+  r = xm_plan(&xmc, e->chcr, e->madr, e->qwc, e->tadr, &x0, &nx);
