diff -ruN me18d/psp/xme_me.c me18e/psp/xme_me.c
--- me18d/psp/xme_me.c	1970-01-01 00:00:00.000000000 +0000
+++ me18e/psp/xme_me.c	2026-11-08 15:44:05.093892082 +0000
@@ -0,0 +1,56 @@
+/* xme_me.c (task #180 step 4d-4, me_step4_notes.md 4d): the Media Engine's side of the picture loop (ge/xme.c): its entry, its waits and
+   its cache steps.  Built with the ME-safe picture objects (-fno-jump-tables -DMGS2_ME_SAFE; its .data and .bss, none, renamed) and run
+   only on the ME, at the kseg0 alias of its addresses.  It holds the instructions the picture code may not (tools/dev/me14/mecheck.py
+   rule 4), as hle_me.h's ME-side helpers do: Count reads, cache operations, sync, HALT, the FPU rule (ctc1) and $gp's top bit; its
+   own check is in the build script (mkpsp18f.sh).  Here the ME writes nothing cached outside its stack: its entry and waits touch the
+   control block and the loop's shared words through the uncached alias only (a wait comes between entries, or inside one while the
+   ME holds its turn), so none of its writes lands in memory the main CPU owns at the time. */
+#include <stdint.h>
+#include "xme_me.h"
+
+#define XME_ME_5US 1657u    /* 5 us of the ME's Count (331.310 MHz, probe 2 [C]) */
+
+static inline void me_spin(uint32_t ticks) { uint32_t t0 = hle_me_count(); while (hle_me_count() - t0 < ticks) ; }
+
+static void __attribute__((noreturn)) me_leave(volatile XmeMeCtl *c)   /* out of the loop: the whole data cache written back and dropped,
+                                                                           state 2 (hle_me_stop waits for it), halted for good */
+{
+  hle_me_dwbinv_all();
+  c->h.state = 2; hle_me_sync();
+  hle_me_halt();
+}
+
+void xme_me_wait(XmeCtx *x, int why)
+{
+  volatile XmeSh *s = XS(x);
+  volatile XmeMeCtl *c = (volatile XmeMeCtl *)(uintptr_t)s->me_ctl;
+  if (why == 2) hle_me_halt();   /* the hang test: halted for good, its cache written back first (ge/xme.c); the main CPU's take-back
+                                    holds it in reset */
+  if (c->h.exit_req) me_leave(c);
+  if (why == 0) {                /* the queue empty: until the main CPU posts (its head every 5 us), at most 0.5 ms */
+    uint32_t t = s->tail;
+    for (int k = 0; k < 100 && s->head == t; k++) me_spin(XME_ME_5US);
+  } else me_spin(why == 1 ? 4u * XME_ME_5US : XME_ME_5US);   /* the GE (a frame's start): 20 us; the heap's answer: 5 us */
+  c->h.count = hle_me_count(); c->h.heartbeat++;
+}
+
+void xme_me_cache(XmeCtx *x, int op, const void *p, uint32_t n)
+{
+  (void)x;
+  if (op == XME_C_ALL) hle_me_dwbinv_all();
+  else if (n) { hle_me_dinval(p, n); hle_me_sync(); }
+}
+
+void xme_me_main(volatile HleMeHdr *h)
+{
+  volatile XmeMeCtl *c = (volatile XmeMeCtl *)h;
+  XmeCtx *x;
+  /* ME_CALLP (ge/me_rt.h): a call through a pointer goes to the kseg0 alias when $gp's top bit is set; the stub loads $gp = _gp */
+  __asm__ volatile(".set push\n\t.set noat\n\tlui $1, 0x8000\n\tor $28, $28, $1\n\t.set pop" ::: "memory");
+  { uint32_t f = 0x01000001u; __asm__ volatile("ctc1 %0, $31\n\tnop\n\tnop" : : "r"(f)); }   /* the main thread's FPU rule (flush to
+                                                                                               zero, toward zero: main_psp.c, A9) */
+  x = c->x;
+  c->h.boots++; c->h.state = 1; hle_me_sync();
+  xme_run(x, xme_me_wait);       /* until XE_STOP (its cache written back and dropped there) */
+  me_leave(c);
+}
diff -ruN me18d/psp/xme_me.h me18e/psp/xme_me.h
--- me18d/psp/xme_me.h	1970-01-01 00:00:00.000000000 +0000
+++ me18e/psp/xme_me.h	2026-11-08 15:43:33.025890176 +0000
@@ -0,0 +1,24 @@
+/* xme_me.h (task #180 step 4d-4, me_step4_notes.md 4d): the picture loop (ge/xme.c) on the PSP's Media Engine: the control block that
+   hle_me_start hands the ME, and the ME's side of the loop (psp/xme_me.c: its entry, its waits, its cache steps), which the main CPU
+   installs (psp/xl_psp.c mq_me_start).  The emulator has no ME: there hle_me_start refuses and the loop runs as 4c's thread. */
+#ifndef MGS2_XME_ME_H
+#define MGS2_XME_ME_H
+#include <stdint.h>
+#include "hle_me.h"
+#include "../ge/xme.h"
+
+typedef struct XmeMeCtl {   /* 128 bytes, 64-aligned; both cores reach it only through the uncached alias */
+  HleMeHdr h;               /* hle_me.h's head: magic, heartbeat (the ME's waits move it), state (1 running, 2 left the loop: its cache
+                               written back, halting), exit_req, count (the ME's Count at its last wait), boots */
+  XmeCtx *x;                /* the loop's ctx (cached; the ME reaches its shared words through XS, xme.h) */
+  uint32_t pad[15];
+} XmeMeCtl;
+
+void xme_me_main(volatile HleMeHdr *h);   /* the ME's entry (hle_me_start's work, at its kseg0 alias): $gp's top bit (ME_CALLP), the main
+                                             thread's FPU rule, then the loop until XE_STOP; its cache written back, state 2, halt */
+void xme_me_wait(XmeCtx *x, int why);     /* the loop's waits on the ME (xme.h XmeWait): 0 the queue empty (until the main CPU posts, its
+                                             head looked at every 5 us, at most 0.5 ms), 1 the GE (20 us), 2 the hang test (halted for
+                                             good), 3 the heap's answer (5 us); an exit request leaves the loop (hle_me_stop) */
+void xme_me_cache(XmeCtx *x, int op, const void *p, uint32_t n);   /* the ME's cache steps (xme.h XmeCache): XME_C_ALL its whole data
+                                                                       cache written back and invalidated, XME_C_INV a range invalidated */
+#endif
