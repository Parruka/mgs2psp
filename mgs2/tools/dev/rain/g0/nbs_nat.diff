+  __asm__ volatile(".set push\n\t.set noreorder\n\tmove %[cc], $0\n\tlv.q C000, 0(%[a])\n\tlv.q C010, 0(%[b])\n\tvpfxd ,,,m\n\t"
+                   "vmul.q C010, C000, C010\n\tvpfxt y,y,y,y\n\tvpfxd ,m,m,m\n\tvadd.q C010, C010, C010\n\tvpfxt z,z,z,z\n\tvpfxd ,m,m,m\n\t"
+                   "vadd.q C010, C010, C010\n\tvcmp.t ES, C010, C010\n\tbvtl 4, 1f\n\tori %[cc], %[cc], 0x10\n\t1:\n\tsv.q C010, 0(%[o])\n\t.set pop"
