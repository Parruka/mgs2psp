+static inline uint32_t nat_vm(uint32_t a, uint32_t b) { return F2I(vu_rnmul(I2F(a), I2F(b))); }
+static inline uint32_t nat_va(uint32_t a, uint32_t b) { return F2I(vu_rnadd(I2F(a), I2F(b))); }
+#define NAT_FIN4(o) (vu_fin((o)[0]) && vu_fin((o)[1]) && vu_fin((o)[2]) && vu_fin((o)[3]))
+static int nat_bs_turn(const uint32_t *m, uint32_t *v, int32_t n, uint32_t *a)
+{
+  for (int32_t i = 0; i < n; i++, v += 4) {
+    uint32_t t[4], o[4];
+    for (int k = 0; k < 4; k++) t[k] = nat_vm(m[k], v[0]);
+    for (int k = 0; k < 4; k++) t[k] = nat_va(t[k], nat_vm(m[4 + k], v[1]));
+    for (int k = 0; k < 4; k++) o[k] = nat_va(t[k], nat_vm(m[8 + k], v[2]));
+    if (!NAT_FIN4(o)) return 0;
+    memcpy(v, o, 16);
+    if (i == n - 1) memcpy(a, t, 16);
+  }
+  return 1;
+}
+static inline int nat_bs_dot(const uint32_t *a, const uint32_t *b, uint32_t *o)
+{
+  uint32_t p0 = nat_vm(a[0], b[0]), p1 = nat_vm(a[1], b[1]), p2 = nat_vm(a[2], b[2]);
+  o[0] = nat_va(nat_va(p0, p1), p2); o[1] = p1; o[2] = p2; o[3] = b[3];
+  return vu_fin(o[0]) && vu_fin(o[1]) && vu_fin(o[2]);
+}
+static inline int nat_bs_xf(const uint32_t *m, const uint32_t *v, uint32_t *o, uint32_t *a)
+{
+  uint32_t t[4];
+  for (int k = 0; k < 4; k++) t[k] = nat_vm(m[k], v[0]);
+  for (int k = 0; k < 4; k++) t[k] = nat_va(t[k], nat_vm(m[4 + k], v[1]));
+  for (int k = 0; k < 4; k++) t[k] = nat_va(t[k], nat_vm(m[8 + k], v[2]));
+  for (int k = 0; k < 4; k++) o[k] = nat_va(t[k], nat_vm(m[12 + k], 0x3f800000u));
+  memcpy(a, t, 16);
+  return NAT_FIN4(o);
+}
