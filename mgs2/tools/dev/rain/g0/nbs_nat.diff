+/* P125f18's group (0x125f44): o = VF8 (the matrix times v with w 1), a = ACC; 0 = a lane NaN / infinity */
+static inline int nat_bs_xf(const uint32_t *m, const uint32_t *v, uint32_t *o, uint32_t *a)
+{
+  uint32_t cc;
+  __asm__ volatile(".set push\n\t.set noreorder\n\tmove %[cc], $0\n\tlv.q C000, 0(%[m])\n\tlv.q C010, 0(%[v])\n\tlv.q C030, 16(%[m])\n\t"
+                   "lv.q C100, 32(%[m])\n\tlv.q C110, 48(%[m])\n\tvpfxt x,x,x,x\n\tvmul.q C020, C000, C010\n\tvpfxt y,y,y,y\n\t"
+                   "vmul.q C730, C030, C010\n\tvadd.q C020, C020, C730\n\tvpfxt z,z,z,z\n\tvmul.q C730, C100, C010\n\tvadd.q C020, C020, C730\n\t"
+                   "vpfxt 1,1,1,1\n\tvmul.q C730, C110, C700\n\tvadd.q C010, C020, C730\n\tvcmp.q ES, C010, C010\n\tbvtl 4, 1f\n\t"
+                   "ori %[cc], %[cc], 0x10\n\t1:\n\tsv.q C010, 0(%[o])\n\tsv.q C020, 0(%[a])\n\t.set pop"
+                   : [cc] "=&r"(cc) : [m] "r"(m), [v] "r"(v), [o] "r"(o), [a] "r"(a) : "memory");
+  return !(cc & 0x10u);
+}
