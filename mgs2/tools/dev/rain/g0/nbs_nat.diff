+#define NAT_BS_MAT 0x1b99f0u              /* P125a78 / P125f78 / P125f18's matrix (lui 0x1c, addiu -26128: 0x1c0000 - 0x6610) */
+#define NAT_BS_VO 0x0300u                 /* host offsets (GUEST_SPR0) of 0x70000300 (the vertices) and 0x70002180 (the normals) */
+#define NAT_BS_NO 0x2180u
+#define NAT_BS_MAXN 488                   /* (0x2180 - 0x0300) / 16: the two copies stay apart, the normals inside the scratchpad */
