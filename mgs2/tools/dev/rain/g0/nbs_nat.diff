+                   "1:\n\tlv.q C010, 0(%[v])\n\tvpfxt x,x,x,x\n\tvmul.q C020, C000, C010\n\tvpfxt y,y,y,y\n\tvmul.q C730, C030, C010\n\t"
+                   "vadd.q C020, C020, C730\n\tvpfxt z,z,z,z\n\tvmul.q C730, C100, C010\n\tvadd.q C010, C020, C730\n\tvcmp.q ES, C010, C010\n\t"
+                   "bvtl 4, 2f\n\tli %[bad], 1\n\tsv.q C010, 0(%[v])\n\taddiu %[v], %[v], 16\n\tbne %[v], %[e], 1b\n\tnop\n\tsv.q C020, 0(%[a])\n"
+                   "2:\n\t.set pop"
