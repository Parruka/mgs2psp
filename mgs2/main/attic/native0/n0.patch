+
+/* report windows by vblank: the opening and the talk, the deck before the rain, the rain, w01a */
+static int nat_win(long vb) { return vb < 24000 ? 0 : vb < 29300 ? 1 : vb <= 31400 ? 2 : 3; }
+static const char *const nat_wname[4] = { "opening (vb < 24000)", "deck before the rain (24000-29299)", "rain (29300-31400)", "w01a (31401-37800)" };
+static struct { long pics, rec_max, grp_max, blk_max, orphan, unrec, cen_rec, cen_pre, cen_bpkt, cen_bsame, cen_bsame_pre, cen_bptr, cen_bsame_max, cen_bpkt_max;
+                long long bytes, bytes_nb, rec, grp, cen_bpkt_bytes; long bytes_max, bytes_max_nb; } NW[4];
+static uint8_t nat_caller[2][NAT_MAXREC];   /* by mesh+0xCE bit 1: 0 opaque (0x122608, pass 6), 1 sorted (0x121c30, pass 13); 2 unused */
+static struct { long rec, grp, match, inv, between, wp_stale, wp_key; long chain[NAT_MAXCHAIN]; } NC[3];
+static int nat_lastk[2][3]; static long nat_pendk[2][3];
+static long nat_cpic_bsame;
+static inline uint32_t nat_r32(uint32_t a) { if ((a >> 28) == 7) return *(const uint32_t *)(g_spr + (a & 0x3ffc)); return *(const uint32_t *)(g_mem + (a & (GUEST_SIZE - 1) & ~3u)); }
