+    if (nat_cpic_bchg > NS.cen_bchg_max) NS.cen_bchg_max = nat_cpic_bchg; if (nat_cpic_bpkt > NS.cen_bpkt_max) NS.cen_bpkt_max = nat_cpic_bpkt;
+    NS.cen_pics++;
+    { int wi = nat_win(k_vblanks); NW[wi].pics++; NW[wi].bytes += by; NW[wi].bytes_nb += bn; if (by > NW[wi].bytes_max) NW[wi].bytes_max = by;
+      if (bn > NW[wi].bytes_max_nb) NW[wi].bytes_max_nb = bn; NW[wi].rec += s->nrec; NW[wi].grp += s->ngrp;
+      if ((long)s->nrec > NW[wi].rec_max) NW[wi].rec_max = s->nrec; if ((long)s->ngrp > NW[wi].grp_max) NW[wi].grp_max = s->ngrp;
+      if ((long)s->nblk > NW[wi].blk_max) NW[wi].blk_max = s->nblk;
+      if (nat_cpic_bsame > NW[wi].cen_bsame_max) NW[wi].cen_bsame_max = nat_cpic_bsame; if (nat_cpic_bpkt > NW[wi].cen_bpkt_max) NW[wi].cen_bpkt_max = nat_cpic_bpkt; }
