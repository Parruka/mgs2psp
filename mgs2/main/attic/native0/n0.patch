+#define NAT_NONE 0xffffffffu
+
+/* one 0x1214a0 call (32 B) */
+typedef struct {
+  uint32_t mesh;                 /* the mesh */
+  uint32_t blk;                  /* SPR 0xc54 = mesh+0xFC: the constant block (packet memory), q0's ADDR */
+  uint32_t fog;                  /* SPR 0xb90 = mesh+0xF8: q6 z */
+  uint32_t blkc;                 /* its copy: byte offset in NatSnap.blk, NAT_NONE when not copied */
+  uint16_t g0, ng;               /* its groups: grp[g0 .. g0 + ng), the skipped ones included */
+  uint8_t clip, pre, chain, chan; /* mesh+0xC8 & 1 (q6 w), mesh+0xC0 & 1 (pre-lit), the chain list's last entry at the call, the channel */
+  uint32_t dest, end;            /* SPR 0xc70 / 0xc74: the packet control's RAM destination and end at the call (dev) */
