+/* nat_hook.c: n0, the native renderer's step 0 on the x86 twin (native_renderer_design.md 6, 6.1; container only).  Included by
+   boot_x86.c (-DNAT_HOOK).  MGS2_NAT=1: shadow: the builder 0x1214a0 runs as always; its FN_ENTER (boot/dg_lite.h) writes the call's
+   record into the snapshot of the packet buffer it writes (ge/natsnap.h): the builder's choices worked out in C from the mesh, its
+   descriptors and the scratchpad's packet control (which groups, nA nB nC, the header words, the VU1 entry index, each group's packet
+   address); the constant block copied; the chanl copied at 0x121060's return (boot/dispatch.h).  The one walk (runtime/ee_io.h
+   vif1_chain_fast) checks every packet tag against the snapshot: the record's group words against the packet's, the order, the chains.
+   MGS2_NAT=2: the same, and the walk hands each recorded group to the native front end (ge/natp04.c) instead of the lane: the picture
+   is made from the records (the frame digests then compare with a MGS2_NAT=0 run).  The game state never depends on it: the hook
+   writes host memory only.  MGS2_NAT_BLK=0: the front end reads the constant block from packet memory, not the copy.
+   Census (UNKNOWN #10): every call's streams A, B, C hashed per picture, against the mesh's previous picture.
+   Lines: "nat:" summary at the exit; "natc:" per full pipeline call (records, groups, bytes, census). */
+#include "../ge/natsnap.h"
+#include "../ge/natp04.h"
+
+static int nat_mode = -1, nat_blk = 1, nat_verbose = 0;
+int g_nat_on;   /* MGS2_NAT=3: the builder stubbed (boot/gen_pre.h FN_ENTER), the records drawn, merged by key */
+static int nat_cur3[2], nat_stop_on = 1;   /* MGS2_NAT_STOP=0: run lanes not stopped at the next key (the first on-mode run) */
+static NatSnap nat_s[2];
+static NatSnap *nat_cur; static uint32_t nat_seq;
+static uint16_t nat_ord[2][NAT_MAXGRP]; static int nat_nord[2];
+static uint8_t nat_walked[2][NAT_MAXGRP], nat_blkchk[2][NAT_MAXREC];
+static int nat_last[2], nat_lastc[2][NAT_MAXCHAIN]; static long nat_pend[2][NAT_MAXCHAIN]; static uint32_t nat_span_end[2]; static long nat_tagsb[2];
+static uint32_t nat_xf_start, nat_xf_last; static int nat_xf_in;
+static uint32_t nat_w[8192 * 32]; static uint32_t nat_wn;   /* the front end's group words for the transfer being walked */
+static struct {
+  long calls, lite, rec, rec_empty, grp, grp_full, skip, flush, drop, buf_bad, unsorted, mstab_chg, chan, chan_out, key_gap;
+  long long bytes, bytes_nb; long bytes_max, bytes_max_nb, pics; long min_margin, min_margin16; int margin_set;
+  long on_left, on_left_pics, on_emit, on_core, on_fed, on_bad, on_state, on_desc, back_to[NAT_MAXCHAIN], back_same, unrec_y0, tags_sub, match_sub, key_off_max, unwalked_pics, unwalked_all, unwalked_unsent, tags, back, match, twice, inv, inv_chain, chain_bad, unrec, unwalked, words_bad, wclass[8][4], blk_bad, blk_chk, xf, xf_chain, xf_other;
