+  uint32_t mat;                  /* desc+0x14: the material block, q1's ADDR (REF 8) */
+  uint32_t s[3];                 /* streams A, B, C: the REF's ADDR (the mesh's cursor), 0: not sent (CNT 0 and a NOP) */
+  uint8_t n[3];                  /* their quadwords: desc+0x0E, +0x0F, +0x10 (0: not sent) */
+  uint8_t flags;                 /* NATG_* */
+  uint8_t cnt;                   /* desc+0x0C: the vertex count, q6 x */
+  uint8_t idx;                   /* the VU1 entry index (mesh_packets 3.1) */
+  uint16_t rec;                  /* its call: rec[rec] */
+  uint32_t mscal;                /* q7 x: 0x14000000 | the entry's halfword (SPR 0xb9c + 2 idx, sign-extended) */
+} NatGrp;
+
+typedef struct {
+  uint32_t seq, vb, buf, lite;   /* the pipeline call's number, vblank, packet buffer base (0x1b00000 / 0x1d00000), 1: reduced */
+  uint32_t nrec, ngrp, nblk, nch, drop;   /* counts; drop: calls or groups that did not fit */
+  uint32_t nchain;               /* the chain list's entries at the call's end: start addresses (RAM) and kinds */
+  uint32_t chain_start[NAT_MAXCHAIN];
+  uint16_t chain_kind[NAT_MAXCHAIN];
+  uint16_t mstab[16];            /* SPR 0xb9c at the first record (the MSCAL table, from 0x17cff0) */
+  uint32_t ch_addr[NAT_MAXCH];   /* the chanl copied */
+  NatRec rec[NAT_MAXREC];
+  NatGrp grp[NAT_MAXGRP];
+  uint8_t blk[NAT_MAXBLK][NAT_BLK];
+  uint8_t ch[NAT_MAXCH][NAT_CHAN];
+} NatSnap;
+
+/* the bytes a picture's snapshot needs: the header part, the records, the groups, the block and channel copies */
+#define NAT_SNAP_BYTES(s) (64u + 32u * (s)->nrec + 32u * (s)->ngrp + NAT_BLK * (s)->nblk + NAT_CHAN * (s)->nch)
+#endif
