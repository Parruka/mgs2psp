+
+/* one group of a call (32 B): what the builder writes for it */
+enum { NATG_FULL = 1,            /* the full template: q0, the constant block's REF, first (the call's first two groups) */
+       NATG_SKIP = 2,            /* skipped: the packet buffer would overflow (end < dest + qwc, the builder's test) */
+       NATG_FLUSH = 4 };         /* the scratchpad half was flushed before it */
