diff -ruN main/ge/natp04.c n0/ge/natp04.c
--- main/ge/natp04.c	1970-01-01 00:00:00.000000000 +0000
+++ n0/ge/natp04.c	2026-11-20 16:45:21.074745604 +0000
@@ -0,0 +1,81 @@
+/* natp04.c: the native front end for ship meshes (natp04.h).  ME-safe: no C library, no system call, no static data but constants. */
+#include <stdint.h>
+#include "natp04.h"
+#include "xlate.h"
+#include "me_rt.h"
+
+/* the template's constant words (0x1213b0 / 0x18dcf0 copied to SPR 0x190 / 0x210 at the pass's start; re/mesh_packets.md 3) */
+#define T_REF 0x30000000u        /* REF, no IRQ */
+#define T_CNT 0x10000000u        /* CNT */
+#define S_11 0x01000101u         /* STCYCL 1 / 1 */
+#define S_31 0x01000103u         /* STCYCL 3 / 1 */
+#define U_BLK 0x6c188000u        /* UNPACK V4-32 24 -> T + 0 */
+#define U_MAT 0x6c0880e8u        /* UNPACK V4-32 8 -> T + 0xe8 */
+#define U_A 0x6d008100u          /* UNPACK V4-16 2 n -> T + 0x100 (| n << 17) */
+#define U_B 0x6d008101u          /* -> T + 0x101 */
+#define U_C 0x75008102u          /* UNPACK V2-16 masked 4 n -> T + 0x102 (| n << 18) */
+#define U_HDR 0x6c018014u        /* UNPACK V4-32 1 -> T + 0x14 */
+
+static const uint32_t *nat_ptr(const NatMem *m, uint32_t a, uint32_t n)   /* the DMAC's view of guest address a, n quadwords, or 0 */
+{
+  if (a & 0x80000000u) { uint32_t o = a & 0x3ff0u; return o + 16u * n <= 0x4000u ? (const uint32_t *)(const void *)(m->spr + o) : 0; }
+  { uint32_t b = a & (m->ram_size - 1u) & ~15u; return b + 16u * n <= m->ram_size ? (const uint32_t *)(const void *)(m->ram + b) : 0; }
+}
+static void q4(uint32_t *w, uint32_t a, uint32_t b, uint32_t c, uint32_t d) { w[0] = a; w[1] = b; w[2] = c; w[3] = d; }
+
+int nat_p04_words(const NatSnap *s, const NatGrp *g, uint32_t *w)
+{
+  if (g->flags & NATG_SKIP) return 0;
+  if (g->rec >= s->nrec || g->rec >= NAT_MAXREC) return 0;
+  {
+    const NatRec *r = &s->rec[g->rec]; int q = 0;
+    if (g->flags & NATG_FULL) { q4(w, T_REF | 24u, r->blk, S_11, U_BLK); q = 1; }
+    q4(w + 4 * q, T_REF | 8u, g->mat, S_11, U_MAT); q++;
+    for (int k = 0; k < 3; k++, q++) {
+      uint32_t n = g->n[k];
+      if (g->s[k] && n) q4(w + 4 * q, T_REF | n, g->s[k], S_31, k == 2 ? U_C | n << 18 : (k ? U_B : U_A) | n << 17);
+      else q4(w + 4 * q, T_CNT, 0, S_31, 0);
+    }
+    q4(w + 4 * q, T_CNT | 2u, 0, S_11, U_HDR); q++;
+    q4(w + 4 * q, g->cnt, 0, r->fog, r->clip); q++;
+    q4(w + 4 * q, g->mscal, 0, 0, 0); q++;
+    return q;
+  }
+}
+
+int nat_p04_group(const NatSnap *s, const NatGrp *g, const NatMem *m, const NatFeed *f, uint32_t *w, int blk_copy)
+{
+  if (g->flags & NATG_SKIP) return NATP_SKIP;
+  if (g->rec >= s->nrec || g->rec >= NAT_MAXREC) return NATP_BAD_REC;
+  if (g->n[0] > 128u || g->n[1] > 128u || g->n[2] > 64u) return NATP_BAD_CNT;   /* the UNPACK's count field: 2 n, 2 n, 4 n <= 256 */
+  {
+    const NatRec *r = &s->rec[g->rec]; int q0 = (g->flags & NATG_FULL) != 0, nr = 4 + q0, nq = nat_p04_words(s, g, w), all = 1;
+    const uint32_t *dp[5];
+    if (nq != 7 + q0) return NATP_BAD_REC;
+    if (q0) {   /* the constant block: the snapshot's copy, or packet memory */
+      if (blk_copy) { if (r->blkc == NAT_NONE || r->blkc > (uint32_t)(NAT_MAXBLK - 1) * NAT_BLK || r->blkc % NAT_BLK) return NATP_BAD_REC;
+        dp[0] = (const uint32_t *)(const void *)&s->blk[r->blkc / NAT_BLK][0]; }
+      else if (!(dp[0] = nat_ptr(m, r->blk & 0xfffffff0u, 24))) return NATP_BAD_PTR;
+    }
+    if (!(dp[q0] = nat_ptr(m, g->mat & 0xfffffff0u, 8))) return NATP_BAD_PTR;
+    for (int k = 0; k < 3; k++) {
+      if (!g->s[k] || !g->n[k]) { dp[q0 + 1 + k] = 0; all = 0; continue; }
+      if (!(dp[q0 + 1 + k] = nat_ptr(m, g->s[k] & 0xfffffff0u, g->n[k]))) return NATP_BAD_PTR;
+    }
+    if (all) {   /* lane 1's case: every slot a REF (runtime/ee_io.h lane_p04's tests hold by construction) */
+      XlP04 x;
+      for (int j = 0; j < nr; j++) { const uint32_t *t = w + 4 * j; x.dp[j] = dp[j]; x.stc[j] = t[2]; x.unp[j] = t[3]; x.qwc[j] = t[0] & 0xffffu; }
+      x.hunp = U_HDR; x.hdr = w + 4 * (nr + 1); x.tadr = g->key; x.q0 = q0;
+      if (xl_p04_core(&x)) return NATP_CORE;
+    }
+    /* the generic walk's order: each tag's TTE words, then its data (a REF's where it lies, the CNT's after the tag) */
+    for (int j = 0; j < nr; j++) {
+      const uint32_t *t = w + 4 * j; uint32_t n = t[0] & 0xffffu;
+      ME_CALLP(f->span)(f->ctx, t + 2, 2, g->key + 16u * (uint32_t)j + 8u);
+      if (t[0] >> 28 == 3 && n) ME_CALLP(f->span)(f->ctx, dp[j], 4 * n, t[1] & 0xfffffff0u);
+    }
+    ME_CALLP(f->span)(f->ctx, w + 4 * nr + 2, 2, g->key + 16u * (uint32_t)nr + 8u);
+    ME_CALLP(f->span)(f->ctx, w + 4 * (nr + 1), 8, g->key + 16u * (uint32_t)(nr + 1));
+    return NATP_FED;
+  }
+}
diff -ruN main/ge/natp04.h n0/ge/natp04.h
--- main/ge/natp04.h	1970-01-01 00:00:00.000000000 +0000
+++ n0/ge/natp04.h	2026-11-20 16:45:21.042745602 +0000
@@ -0,0 +1,28 @@
+/* natp04.h: the native front end for ship meshes, step 0 (native_renderer_design.md 6, 6.1): a 0x1214a0 group from its record
+   (ge/natsnap.h) to lane 1's converter core (ge/xlate.h xl_p04_core), with the record's pointers and header words in place of the
+   packet's.  ME-safe: no C library, no system call, no static data but constants; every guest pointer is range-checked and every count
+   capped before use (a bad group is dropped and its code returned). */
+#ifndef MGS2_NATP04_H
+#define MGS2_NATP04_H
+#include <stdint.h>
+#include "natsnap.h"
+
+typedef struct { const uint8_t *ram; uint32_t ram_size; const uint8_t *spr; } NatMem;   /* EE RAM (ram_size a power of two: the DMAC's
+                                                                                          mask) and the 16 KB scratchpad */
+typedef void (*NatSpanFn)(void *ctx, const uint32_t *p, uint32_t nw, uint32_t src);    /* nw words that came from guest address src */
+typedef struct { NatSpanFn span; void *ctx; } NatFeed;
+
+enum { NATP_CORE = 1,            /* the converter core took the group (xl_p04_core) */
+       NATP_FED = 2,             /* a stream not sent, or the core declined: fed word by word (the generic walk's order) */
+       NATP_SKIP = 0,            /* a group the builder skipped: nothing */
+       NATP_BAD_REC = -1,        /* the group's record or block copy out of the snapshot */
+       NATP_BAD_CNT = -2,        /* a count over its cap */
+       NATP_BAD_PTR = -3 };      /* a pointer out of EE RAM / the scratchpad */
+
+/* the group's quadwords as the builder copies them to the packet: 8 from q0 (NATG_FULL) or 7 from q1; the words in w[0 .. 4 * return);
+   a CNT tag's ADDR word is 0 (the builder leaves an older pointer there; the DMAC ignores it).  0: a skipped group or a bad record */
+int nat_p04_words(const NatSnap *s, const NatGrp *g, uint32_t *w);
+/* the group handed to the translator.  w: 32 words of the caller's that stay valid until the transfer ends (the core reads the header
+   from there).  blk_copy: 1 the constant block from the snapshot's copy, 0 from RAM.  NATP_* */
+int nat_p04_group(const NatSnap *s, const NatGrp *g, const NatMem *m, const NatFeed *f, uint32_t *w, int blk_copy);
+#endif
diff -ruN main/ge/natsnap.h n0/ge/natsnap.h
--- main/ge/natsnap.h	1970-01-01 00:00:00.000000000 +0000
+++ n0/ge/natsnap.h	2026-11-20 16:57:15.851142255 +0000
@@ -0,0 +1,61 @@
+/* natsnap.h: the native renderer's snapshot, step 0 (native_renderer_design.md 1.5, 6): ship meshes (the 0x1214a0 builder) only.
+   The layout both CPUs share: guest addresses and offsets, no host pointers.  The main CPU (boot/nat_hook.c) writes it inside the
+   pipeline call, one per packet buffer; the walk reads it while that buffer's transfers run (ge/natp04.c the front end).
+   Game data passes through it: personal use only. */
+#ifndef MGS2_NATSNAP_H
+#define MGS2_NATSNAP_H
+#include <stdint.h>
+
+#define NAT_MAXREC 1024          /* 0x1214a0 calls a picture (the rain: about 150 [design 1.5]) */
+#define NAT_MAXGRP 8192          /* groups a picture (RAM 24051 chain 3: 1554 [mesh_packets 3]) */
+#define NAT_MAXBLK 1024          /* constant block copies a picture (one a call at most) */
+#define NAT_MAXCH 4              /* channel copies a picture */
+#define NAT_MAXCHAIN 16          /* chain list entries kept */
