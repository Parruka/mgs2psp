+static inline uint32_t nat_spr32(uint32_t o) { return *(const uint32_t *)(g_spr + o); }
+
+/* census (UNKNOWN #10): per mesh, the hashes of its streams at its last picture */
+typedef struct { uint32_t mesh, seq, ha, hb, hc, pb; } NatCen;
+static NatCen nat_cen[8192];
+static uint32_t nat_fnv(uint32_t h, const uint8_t *p, uint32_t n) { for (uint32_t i = 0; i < n; i++) { h ^= p[i]; h *= 16777619u; } return h; }
+static long nat_cpic_bchg, nat_cpic_bpkt;
+
+static void nat_init(void)
+{
+  const char *e = getenv("MGS2_NAT"); nat_mode = e ? atoi(e) : 0;
+  e = getenv("MGS2_NAT_BLK"); if (e) nat_blk = atoi(e);
+  e = getenv("MGS2_NAT_V"); if (e) nat_verbose = atoi(e);
+  e = getenv("MGS2_NAT_STOP"); if (e) nat_stop_on = atoi(e);
+  g_nat_on = nat_mode == 3;
+  void nat_report(void); if (nat_mode) atexit(nat_report);
+}
+static void nat_reset(NatSnap *s, int b)
+{
+  if (nat_mode == 3 && s->nrec && nat_tagsb[b]) { NS.on_left += nat_nord[b] - nat_cur3[b]; if (nat_nord[b] > nat_cur3[b]) NS.on_left_pics++; }
+  nat_cur3[b] = 0;
+  if (s->nrec && nat_mode != 3) { long u = 0, f = -1; for (int i = 0; i < nat_nord[b]; i++) if (!nat_walked[b][nat_ord[b][i]]) { u++; if (f < 0) f = nat_ord[b][i]; }
+    NS.unwalked += u; if (u) { NS.unwalked_pics++; if (u == nat_nord[b]) NS.unwalked_all++; if (!nat_tagsb[b]) NS.unwalked_unsent++; }
+    if (u && nat_verbose) fprintf(stderr, "nat: vb %u seq %u: %ld of %d groups not walked (first %ld key %08x; buffer tags walked %ld), now vb %ld\n", s->vb, s->seq, u, nat_nord[b], f,
+                                  s->grp[f].key, nat_tagsb[b], k_vblanks); }
+  nat_tagsb[b] = 0;
+  s->nrec = s->ngrp = s->nblk = s->nch = s->drop = s->nchain = 0;
+  nat_nord[b] = 0; memset(nat_walked[b], 0, sizeof nat_walked[b]); memset(nat_blkchk[b], 0, sizeof nat_blkchk[b]);
+  nat_last[b] = -1; for (int k = 0; k < NAT_MAXCHAIN; k++) { nat_lastc[b][k] = -1; nat_pend[b][k] = 0; }
+  for (int k = 0; k < 3; k++) { nat_lastk[b][k] = -1; nat_pendk[b][k] = 0; } nat_span_end[b] = 0;
+}
+/* rt_dg_call: the pipeline call starts (lite: reduced) */
+static void nat_begin(int lite)
+{
+  if (nat_mode < 0) nat_init();
+  if (!nat_mode) return;
+  uint32_t wp = nat_r32(0x1e50a0) & (GUEST_SIZE - 1); int b = wp >= 0x1b00000u && wp < 0x1d00000u;
+  NatSnap *s = &nat_s[b]; nat_reset(s, b);
+  s->seq = ++nat_seq; s->vb = (uint32_t)k_vblanks; s->buf = b ? 0x1b00000u : 0x1d00000u; s->lite = (uint32_t)lite;
+  nat_cur = s; nat_cpic_bchg = nat_cpic_bpkt = nat_cpic_bsame = 0;
+  if (lite) NS.lite++; else NS.calls++;
+}
+static void nat_end(void)
+{
+  if (!nat_mode || !nat_cur) return;
+  NatSnap *s = nat_cur; int b = s == &nat_s[1];
+  { uint32_t list = nat_r32(0x1b9348), n = nat_r32(list); if (n > NAT_MAXCHAIN) n = NAT_MAXCHAIN; s->nchain = n;
+    for (uint32_t i = 0; i < n; i++) { s->chain_start[i] = nat_r32(list + 12 + 16 * i + 4) & (GUEST_SIZE - 1); s->chain_kind[i] = (uint16_t)nat_r16(list + 12 + 16 * i); } }
+  int k = 0; for (uint32_t i = 0; i < s->ngrp; i++) if (!(s->grp[i].flags & NATG_SKIP)) nat_ord[b][k++] = (uint16_t)i;
+  nat_nord[b] = k;
+  for (int i = 1; i < k; i++) if (s->grp[nat_ord[b][i]].key < s->grp[nat_ord[b][i - 1]].key) { NS.on_desc++; break; }   /* (before the sort: record order) */
+  for (int i = 1; i < k; i++) { uint16_t v = nat_ord[b][i]; int j = i - 1;   /* by key (insertion: sorted already when the keys rise) */
+    while (j >= 0 && s->grp[nat_ord[b][j]].key > s->grp[v].key) { nat_ord[b][j + 1] = nat_ord[b][j]; j--; } nat_ord[b][j + 1] = v; }
+  for (int i = 1; i < k; i++) if (s->grp[nat_ord[b][i]].key == s->grp[nat_ord[b][i - 1]].key) NS.key_gap++;   /* two groups at one address */
