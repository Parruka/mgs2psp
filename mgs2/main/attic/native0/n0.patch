+  int r30 = 2; uint32_t hA = 2166136261u, hB = 2166136261u, hC = 2166136261u, b0 = 0; int any_full = 0;
+  for (int i = 0; i < ng; i++, r30--) {
+    uint32_t d = desc + 32u * (uint32_t)i, d0 = nat_r32(d); NatGrp *g = &s->grp[s->ngrp++]; uint32_t idx, m;
