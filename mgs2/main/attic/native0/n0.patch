+  { uint32_t h = nat_spr32(0xc48); int c = 0; while (h && !(h & 0x1000)) { h >>= 1; c++; } r->chan = (uint8_t)(h ? c : 0xff); }
+  if (!s->nrec) for (int i = 0; i < 16; i++) s->mstab[i] = (uint16_t)nat_r16(0x70000b9c + 2 * i);
+  else for (int i = 0; i < 16; i++) if (s->mstab[i] != (uint16_t)nat_r16(0x70000b9c + 2 * i)) { NS.mstab_chg++; break; }
+  { uint32_t d = dest & (GUEST_SIZE - 1); if ((d >= 0x1b00000u && d < 0x1d00000u) != (s->buf == 0x1b00000u) || d < 0x1b00000u || d >= 0x1f00000u) NS.buf_bad++;
+    if (d - (s->buf) > (uint32_t)NS.key_off_max && d >= s->buf) NS.key_off_max = (long)(d - s->buf); }
+  { int cc = (nat_r16(mesh + 0xce) & 2) ? 1 : 0;   /* mesh+0xCE bit 1: a depth-sorted mesh (0x121c30's; 0x122608 skips them) [mesh_packets 3] */ nat_caller[s == &nat_s[1]][s->nrec] = (uint8_t)cc; NC[cc].rec++;
+    NC[cc].grp += ng; if (r->chain < NAT_MAXCHAIN) NC[cc].chain[r->chain]++;
+    { uint32_t wp = nat_r32(0x1e50a0); if (wp != dest) NC[cc].wp_stale++; } }
