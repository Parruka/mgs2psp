+        { const uint8_t *p = g_mem + (cur[k] & (GUEST_SIZE - 1)); if ((cur[k] & (GUEST_SIZE - 1)) + 16 * n <= GUEST_SIZE) {
+            if (k == 0) hA = nat_fnv(hA, p, 16 * n); else if (k == 1) hB = nat_fnv(hB, p, 16 * n); else hC = nat_fnv(hC, p, 16 * n); } }
