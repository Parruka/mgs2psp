+  for (int j = 0; j < 3; j++) { if (g->mat[j]) Q4(0x30000008u, g->mat[j], NP6T_S11, NP6T_MAT + 8u * (uint32_t)j); else Q4(0x10000000u, 0, NP6T_S11, 0); }
