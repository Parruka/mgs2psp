+    if (g->s[k] && n) Q4(0x30000000u | n, g->s[k], NP6T_S61, (v2 ? NP6T_V2 | ((4 * n) & 0xffu) << 16 : NP6T_V4 | ((2 * n) & 0xffu) << 16) + (uint32_t)k);
+    else Q4(0x10000000u, 0, NP6T_S61, 0); }
+  Q4(0x10000002u, 0, NP6T_S11, NP6T_HDR);
+  Q4(g->hdr[0], g->hdr[1], g->hdr[2], g->hdr[3]);
+  Q4(g->mscal, 0, 0, 0);
+#undef Q4
+  return q;
+}
