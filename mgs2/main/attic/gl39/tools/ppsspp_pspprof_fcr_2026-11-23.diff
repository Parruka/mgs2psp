+// local change (MGS2, 2026-11-23, gl39): mul.s / div.s / sqrt.s / cvt.s.w computed in the running thread's FCR31 mode, as add.s / sub.s
+// (MIPSInt.cpp).  Before, they ran in the host's mode, which is set at a slice's start (MIPSTables.cpp) and at ctc1 only: after a thread
+// switch inside a slice it was the previous thread's (a thread with the kernel's default FCR31 00000e00 -> round to nearest, no flush)
+// until the slice's end.  FcrOp: kind 0 mul 1 div 2 sqrt 3 cvt.s.w; counts the operations found in another host mode and those whose
+// result differs between the two modes (the first 24 printed).  PSPPROF_FPU_HOSTMODE=1 keeps the old result (the counts stay).
+struct FcrStat { uint64_t ops, wrongMode, differ; };
+inline FcrStat &fcrStat() { static FcrStat s; return s; }
+inline uint32_t FcrOp(int kind, uint32_t a, uint32_t b, uint32_t fcr31, uint32_t pc) {
+	static const bool old = [] { const char *e = getenv("PSPPROF_FPU_HOSTMODE"); return e && *e == '1'; }();
+	union U { uint32_t u; float f; int32_t i; };
+	auto calc = [&]() -> uint32_t { volatile U x, y; U r; x.u = a; y.u = b;
+		switch (kind) { case 0: r.f = x.f * y.f; break; case 1: r.f = x.f / y.f; break; case 2: r.f = sqrtf(x.f); break; default: r.f = (float)x.i; break; }
+		return r.u; };
+	FcrStat &s = fcrStat(); s.ops++;
+	const uint32_t csr = _mm_getcsr(); const uint32_t r0 = calc();
+	ApplyFcr31Host(fcr31); const uint32_t csr1 = _mm_getcsr(); const uint32_t r1 = calc(); _mm_setcsr(csr);
+	if (((csr ^ csr1) & 0xe040u) != 0) { s.wrongMode++;
+		if (r0 != r1) { if (s.differ++ < 24) fprintf(stderr, "PspProf: fpu mode: op %d at pc %08x: a %08x b %08x: host mode (csr %04x) %08x, FCR31 %08x mode (csr %04x) %08x; ops in another mode so far %llu\n",
+			kind, pc, a, b, csr & 0xffffu, r0, fcr31, csr1 & 0xffffu, r1, (unsigned long long)s.wrongMode); } }
+	return old ? r0 : r1;
+}
